<Window x:Class="GitHabInstaller.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GitHab Installer - Git Project Setup Wizard" 
        Height="700" 
        Width="900"
        WindowStartupLocation="CenterScreen"
        Background="#F3F3F3">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Background="#007ACC" Height="60">
            <StackPanel Orientation="Horizontal" Margin="20,0" VerticalAlignment="Center">
                <TextBlock Text="GitHab Installer" FontSize="24" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                <TextBlock Text="v1.0.0" FontSize="12" Foreground="#CCCCCC" Margin="10,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <!-- Main Content -->
        <ScrollViewer Grid.Row="1" Margin="30,20" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="16">
                <!-- Repository URL -->
                <StackPanel>
                    <TextBlock Text="Repository URL" FontWeight="Bold" FontSize="13" Margin="0,0,0,6"/>
                    <TextBox x:Name="RepoUrlBox" 
                             Height="36" 
                             Padding="10,8" 
                             FontSize="12"
                             Background="White"
                             BorderBrush="#CCCCCC"
                             BorderThickness="1"/>
                    <TextBlock Text="Example: https://github.com/FFmpeg/FFmpeg" FontSize="11" Foreground="#666666" Margin="0,4,0,0"/>
                </StackPanel>

                <!-- Installation Path -->
                <StackPanel>
                    <TextBlock Text="Installation Path" FontWeight="Bold" FontSize="13" Margin="0,0,0,6"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TargetPathBox" 
                                 Height="36" 
                                 Padding="10,8" 
                                 FontSize="12"
                                 Background="White"
                                 BorderBrush="#CCCCCC"
                                 BorderThickness="1"/>
                        <Button Grid.Column="1" 
                                Content="Browse" 
                                Width="100" 
                                Margin="10,0,0,0"
                                Background="#007ACC"
                                Foreground="White"
                                Click="BrowseButton_Click"
                                Cursor="Hand"/>
                    </Grid>
                </StackPanel>

                <!-- Branch Selection -->
                <StackPanel>
                    <TextBlock Text="Branch (Optional)" FontWeight="Bold" FontSize="13" Margin="0,0,0,6"/>
                    <TextBox x:Name="BranchBox" 
                             Height="36" 
                             Padding="10,8" 
                             FontSize="12"
                             Background="White"
                             BorderBrush="#CCCCCC"
                             BorderThickness="1"/>
                    <TextBlock Text="Leave empty for default branch (main/master)" FontSize="11" Foreground="#666666" Margin="0,4,0,0"/>
                </StackPanel>

                <!-- SSH/Token Support -->
                <StackPanel>
                    <TextBlock Text="Authentication (Optional)" FontWeight="Bold" FontSize="13" Margin="0,0,0,6"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <StackPanel Margin="0,0,8,0">
                            <TextBlock Text="GitHub Token" FontSize="11" Foreground="#666666" Margin="0,0,0,4"/>
                            <PasswordBox x:Name="TokenBox" 
                                         Height="36" 
                                         Padding="10,8" 
                                         FontSize="12"
                                         Background="White"
                                         BorderBrush="#CCCCCC"
                                         BorderThickness="1"/>
                        </StackPanel>
                        
                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                            <TextBlock Text="SSH Key Path" FontSize="11" Foreground="#666666" Margin="0,0,0,4"/>
                            <TextBox x:Name="SshKeyBox" 
                                     Height="36" 
                                     Padding="10,8" 
                                     FontSize="12"
                                     Background="White"
                                     BorderBrush="#CCCCCC"
                                     BorderThickness="1"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>

                <!-- Post-Install Options -->
                <StackPanel>
                    <TextBlock Text="Post-Installation Options" FontWeight="Bold" FontSize="13" Margin="0,0,0,10"/>
                    <CheckBox x:Name="AutoRunCheckBox" 
                              Content="Run project after installation (if applicable)"
                              FontSize="12"
                              Margin="0,4"/>
                    <CheckBox x:Name="CreateShortcutCheckBox" 
                              Content="Create desktop shortcut"
                              FontSize="12"
                              Margin="0,4"/>
                    <CheckBox x:Name="OpenFolderCheckBox" 
                              Content="Open installation folder when done"
                              FontSize="12"
                              IsChecked="True"
                              Margin="0,4"/>
                </StackPanel>

                <!-- Divider -->
                <Separator Margin="-30,10"/>

                <!-- Log Output -->
                <StackPanel>
                    <TextBlock Text="Installation Log" FontWeight="Bold" FontSize="13" Margin="0,0,0,6"/>
                    <TextBox x:Name="LogBox"
                             Height="250"
                             Padding="10"
                             IsReadOnly="True"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto"
                             TextWrapping="Wrap"
                             Background="#1E1E1E"
                             Foreground="#00FF00"
                             FontFamily="Consolas"
                             FontSize="11"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <Grid Grid.Row="2" Background="#EEEEEE" Padding="30,15" BorderBrush="#CCCCCC" BorderThickness="0,1,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            
            <TextBlock x:Name="StatusText" 
                       Text="Ready to install" 
                       VerticalAlignment="Center" 
                       Foreground="#666666"
                       FontSize="12"/>
            
            <Button Grid.Column="1" 
                    Content="Clear Log" 
                    Width="120" 
                    Height="40"
                    Margin="0,0,10,0"
                    Background="#CCCCCC"
                    Foreground="#000000"
                    Click="ClearLogButton_Click"
                    Cursor="Hand"/>
            
            <Button Grid.Column="2" 
                    x:Name="InstallButton"
                    Content="Install" 
                    Width="140" 
                    Height="40"
                    Background="#007ACC"
                    Foreground="White"
                    FontSize="13"
                    FontWeight="Bold"
                    Click="InstallButton_Click"
                    Cursor="Hand"/>
        </Grid>
    </Grid>
</Window>